  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    conversationLines:
    - speakerName: Ksatria Pemimpin
      text: Axel Pace. Ksatria paling setia dari kerajaan yang korup. Lihat apa yang
        kesetiaanmu berikan padamu.
    - speakerName: Axel Pace
      text: Alwan... Pengkhianatanmu menghancurkan segalanya.
    - speakerName: Alwan
      text: Menghancurkan? Aku menyelamatkannya! Kerajaan ini sudah busuk dari dalam!
        Kami membangunnya kembali dari abu! Dan kau... kau adalah alat yang sempurna.
        Sayang sekali kau lepas kendali.
  changeMusicOnTrigger: 1
  newBackgroundMusic: {fileID: 8300000, guid: dbdaf9827178e284cb1f5871f86d8a23, type: 3}
